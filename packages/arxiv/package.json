{
  "name": "@paperkit-latex/arxiv",
  "version": "0.1.0",
  "description": "Prepare LaTeX sources for arXiv: strip comments safely, resolve the include graph, plan and apply cleanup on a zip.",
  "keywords": [
    "arxiv",
    "arxiv-cleaner",
    "tex",
    "comments",
    "submission",
    "preprint",
    "zip",
    "academic",
    "research",
    "paper",
    "latex",
    "scientific-writing",
    "browser",
    "offline",
    "paperkit"
  ],
  "homepage": "https://github.com/kevnantony/paperkit-engines/tree/main/packages/arxiv",
  "bugs": {
    "url": "https://github.com/kevnantony/paperkit-engines/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevnantony/paperkit-engines.git",
    "directory": "packages/arxiv"
  },
  "license": "MIT",
  "author": "Kevin Antony",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/arxiv"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
