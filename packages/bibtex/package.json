{
  "name": "@paperkit/bibtex",
  "version": "0.1.0",
  "description": "BibTeX parser, serializer, cleaner, duplicate finder and DOI/arXiv to BibTeX lookup. Runs in Node and the browser.",
  "keywords": [
    "bibtex",
    "bib",
    "bibliography",
    "citation",
    "parser",
    "doi",
    "arxiv",
    "crossref",
    "deduplicate",
    "reference-manager",
    "academic",
    "research",
    "paper",
    "latex",
    "scientific-writing",
    "browser",
    "offline",
    "paperkit"
  ],
  "homepage": "https://github.com/kevnantony/paperkit-engines/tree/main/packages/bibtex",
  "bugs": {
    "url": "https://github.com/kevnantony/paperkit-engines/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevnantony/paperkit-engines.git",
    "directory": "packages/bibtex"
  },
  "license": "MIT",
  "author": "Kevin Antony",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/bibtex"
  },
  "publishConfig": {
    "access": "public"
  }
}
