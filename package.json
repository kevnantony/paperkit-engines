{
  "name": "paperkit-engines",
  "private": true,
  "description": "Open-source processing engines behind PaperKit: BibTeX, LaTeX, arXiv, double-blind anonymity, PDF checks and figure helpers.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/kevnantony/paperkit-engines.git" },
  "workspaces": [
    "packages/bibtex",
    "packages/latex",
    "packages/arxiv",
    "packages/anon",
    "packages/pdf-check",
    "packages/image"
  ],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "examples": "node scripts/check-readmes.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke && npm run examples"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "20.19.43",
    "eslint": "9.39.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
